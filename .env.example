# --- Telegram bot ---
# Get a token from @BotFather: https://t.me/BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# URL where the FastAPI backend is reachable from the bot process.
BACKEND_BASE_URL=http://127.0.0.1:8000

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Where uploaded training examples are stored.
# DATASET_DIR=./dataset
# Where model artifacts / training status / target profile are stored.
# MODELS_DIR=./models

# Main mode: find a concrete buried target point, not generic objects.
TARGET_CONFIDENCE=0.42

# Optional context models. Keep disabled for the buried-target workflow unless
# you explicitly want extra object / scene labels.
ENABLE_OBJECTS=0
ENABLE_SCENE=0
# DETECTOR_WEIGHTS=yolo11n.pt
DETECTOR_CONFIDENCE=0.35
