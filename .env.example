# --- Telegram bot ---
# Get a token from @BotFather: https://t.me/BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# URL where the FastAPI backend is reachable from the bot process.
BACKEND_BASE_URL=http://127.0.0.1:8000

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Where uploaded training examples are stored.
# DATASET_DIR=./dataset
# Where model artifacts / training status are stored.
# MODELS_DIR=./models

# Optional: path to an Ultralytics YOLO .pt model. If set (and `ultralytics`
# is installed), it replaces the built-in OpenCV heuristic detector.
# DETECTOR_WEIGHTS=./models/yolo.pt
# Minimum confidence for a detection to be reported.
DETECTOR_CONFIDENCE=0.35
